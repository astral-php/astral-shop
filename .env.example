# ============================================================
# Astral Shop — copiez en .env et adaptez (DEV local)
#   cp .env.example .env   (Windows : copy .env.example .env)
# ============================================================
APP_NAME="Astral Shop"
APP_VERSION=1.1.0
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_CHARSET=UTF-8
# Laragon HTTPS local (adapter si besoin)
APP_BASE_URL=https://astral-shop.local
APP_URL=https://astral-shop.local

DB_DRIVER=sqlite
DB_DATABASE=database/starter.sqlite
# MySQL (optionnel) :
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=astral_shop
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4

# Stripe test — https://dashboard.stripe.com/apikeys (laisser vide au départ)
# Webhook local : stripe listen --forward-to https://astral-shop.local/webhooks/stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# direct | confirm — DÉFAUT SHOP = confirm (e-commerce).
# Ne PAS basculer direct → confirm si des comptes existent déjà
# (email_verified_at NULL → login bloqué). Choisir dès l'install.
AUTH_REGISTRATION=confirm

# Branding boutique
SHOP_STORE_NAME="Astral Shop"
SHOP_TAGLINE="Commerce moderne, expérience soignée"
SHOP_HERO_TITLE="Une boutique claire, rapide et professionnelle"
SHOP_HERO_LEAD="Découvrez une sélection soignée — design épuré, parcours fluide, paiement sécurisé."
SHOP_PRIMARY="#4f46e5"
SHOP_CURRENCY=EUR
SHOP_CURRENCY_SYMBOL=€

# Frais de port (astral-shipping — profil standard)
SHOP_FLAT_RATE_CENTS=590
SHOP_FREE_SHIPPING_CENTS=6000
# Adresse de retrait en boutique (affichée au checkout)
SHOP_STORE_ADDRESS="Astral Shop - 12 rue des Lilas, 44000 Nantes"

# Identité légale — À ÉTABLIR PAR LE MARCHAND avant ouverture (pas laisser la démo).
# Les pages /cgv /mentions-legales /retours /confidentialite sont des MODÈLES :
# voir docs/Installation/ouvrir-une-boutique-fr.md §0 (moteur vs marchand) + §3.
SHOP_LEGAL_COMPANY="Astral Shop SAS"
SHOP_LEGAL_ADDRESS="12 rue des Lilas, 44000 Nantes, France"
SHOP_LEGAL_EMAIL=contact@astral-shop.local
SHOP_LEGAL_PHONE=
SHOP_LEGAL_SIRET="000 000 000 00000"
SHOP_LEGAL_RCS=
SHOP_LEGAL_VAT=
SHOP_LEGAL_DIRECTOR="Direction Astral Shop"
SHOP_LEGAL_HOST="[Hébergeur — nom, adresse, contact]"
# Délai retour / rétractation (jours calendaires) — défaut 14 ; à valider pour votre activité
SHOP_RETURN_DAYS=14

# Paiement offline (données FAKE démo — valeurs avec espaces → entre guillemets)
SHOP_TRANSFER_IBAN="FR76 3000 6000 0112 3456 7890 189"
SHOP_TRANSFER_BIC=AGRIFRPPXXX
SHOP_TRANSFER_BENEFICIARY="Astral Shop SAS"
SHOP_CHECK_PAYABLE_TO="Astral Shop SAS"
SHOP_CHECK_MAIL_TO="Astral Shop, 12 rue des Lilas, 44000 Nantes, France"
# Délai paiement offline (jours) — stock réservé jusqu'à échéance ou annulation
SHOP_OFFLINE_PAYMENT_DAYS=7

# Mailpit local : UI http://127.0.0.1:8025 — SMTP 1025
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@astral-shop.local
MAIL_FROM_NAME="Astral Shop"
# Alertes gestionnaire (demandes remboursement…) — défaut = MAIL_FROM
# SHOP_NOTIFY_EMAIL=admin@astral-shop.local

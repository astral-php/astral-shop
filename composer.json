{
    "name": "astral-php/astral-shop",
    "description": "Astral Shop — boutique e-commerce (Stripe, PayPal, shipping, worker)",
    "type": "project",
    "version": "2.0.2",
    "license": "MIT",
    "keywords": [
        "astral",
        "php",
        "mvc",
        "shop",
        "ecommerce",
        "stripe",
        "paypal"
    ],
    "homepage": "https://github.com/astral-php/astral-shop",
    "support": {
        "source": "https://github.com/astral-php/astral-shop",
        "issues": "https://github.com/astral-php/astral-shop/issues"
    },
    "require": {
        "php": "^8.3",
        "astral-php/astral-core": "^2.1",
        "astral-php/astral-payment": "^0.2",
        "astral-php/astral-paypal": "^0.2",
        "astral-php/astral-shipping": "^0.6",
        "astral-php/astral-template": "^0.2",
        "astral-php/astral-worker": "^0.2",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8082 -t public public/router.php",
        "test": "phpunit tests/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

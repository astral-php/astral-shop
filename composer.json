{
  "name": "astral-php/astral-shop",
  "description": "Astral Shop — boutique e-commerce démo (en développement)",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "astral",
    "php",
    "mvc",
    "shop",
    "ecommerce",
    "stripe",
    "paypal"
  ],
  "homepage": "https://github.com/astral-php/astral-shop",
  "support": {
    "source": "https://github.com/astral-php/astral-shop",
    "issues": "https://github.com/astral-php/astral-shop/issues"
  },
  "require": {
    "php": "^8.1",
    "astral-php/astral-core": "^1.2",
    "astral-php/astral-payment": "^0.1.3",
    "astral-php/astral-paypal": "^0.1",
    "astral-php/astral-shipping": "^0.5.3",
    "astral-php/astral-template": "^0.1",
    "dompdf/dompdf": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "audit": {
      "block-insecure": false
    }
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8082 -t public public/router.php",
    "test": "phpunit tests/"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
